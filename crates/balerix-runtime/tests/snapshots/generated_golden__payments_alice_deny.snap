==== launch.sh ====
#!/bin/sh
# generated by balerix — safe to run by hand
exec env -i HOME='<root>/state/fleets/payments/crews/backend/agents/alice/nono' PATH='/usr/local/bin:/usr/bin:/bin:/tools' \
  '/tools/balerix' 'agent-supervise' '--' '/tools/nono' '-s' '--log-file' '<root>/state/fleets/payments/crews/backend/agents/alice/logs/nono.log' 'run' '--profile' '<root>/state/fleets/payments/crews/backend/agents/alice/nono-profile.json' '--' '/tools/balerix' 'sandbox-exec' '--' '/tools/mise' 'exec' '--' 'claude' '--verbose'
