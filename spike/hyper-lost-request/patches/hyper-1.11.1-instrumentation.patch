--- a/src/spike.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/src/spike.rs	2026-10-05 08:24:09.784585643 +0000
@@ -0,0 +1,109 @@
+//! Spike instrumentation (balerix-ai/balerix#129), not part of hyper:
+//! an id per client HTTP/1 connection, shared by its `SendRequest` and its
+//! dispatcher, and a registry of the live connections' last-seen state, so
+//! a caller that has waited too long can dump every connection at once.
+use std::collections::BTreeMap;
+use std::fmt::Write as _;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+
+static NEXT: AtomicU64 = AtomicU64::new(1);
+
+pub(crate) fn next_id() -> u64 {
+    NEXT.fetch_add(1, Ordering::Relaxed)
+}
+
+struct Snap {
+    created: Instant,
+    last_poll: Option<Instant>,
+    polls: u64,
+    state: String,
+    sends: u64,
+    last_send: Option<(Instant, String)>,
+}
+
+static CONNS: Mutex<BTreeMap<u64, Snap>> = Mutex::new(BTreeMap::new());
+
+fn with<F: FnOnce(&mut Snap)>(id: u64, f: F) {
+    if id == 0 {
+        return;
+    }
+    let mut map = CONNS.lock().unwrap_or_else(|e| e.into_inner());
+    let snap = map.entry(id).or_insert_with(|| Snap {
+        created: Instant::now(),
+        last_poll: None,
+        polls: 0,
+        state: String::new(),
+        sends: 0,
+        last_send: None,
+    });
+    f(snap);
+}
+
+pub(crate) fn on_create(id: u64) {
+    with(id, |_| {});
+}
+
+pub(crate) fn on_poll(id: u64, state: String) {
+    with(id, |s| {
+        s.last_poll = Some(Instant::now());
+        s.polls += 1;
+        s.state = state;
+    });
+}
+
+pub(crate) fn on_send(id: u64, what: String) {
+    with(id, |s| {
+        s.sends += 1;
+        s.last_send = Some((Instant::now(), what));
+    });
+}
+
+pub(crate) fn on_drop(id: u64) {
+    if id == 0 {
+        return;
+    }
+    CONNS.lock().unwrap_or_else(|e| e.into_inner()).remove(&id);
+}
+
+/// Removes the connection from the registry when its dispatcher is dropped.
+pub(crate) struct Guard(pub(crate) u64);
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        if self.0 != 0 {
+            #[cfg(all(feature = "tracing", hyper_unstable_tracing))]
+            tracing::trace!(conn = self.0, "spike: dispatcher dropped");
+            on_drop(self.0);
+        }
+    }
+}
+
+/// One line per live client HTTP/1 connection: its age, the time since its
+/// task last polled the dispatcher, the dispatcher's state after that poll,
+/// and the last request handed to it.
+pub fn dump() -> String {
+    let now = Instant::now();
+    let map = CONNS.lock().unwrap_or_else(|e| e.into_inner());
+    let mut out = String::new();
+    for (id, s) in map.iter() {
+        let _ = write!(
+            out,
+            "conn={id} age={:.3}s polls={} since_poll={} sends={} since_send={} last_send={:?} state={}\n",
+            now.duration_since(s.created).as_secs_f64(),
+            s.polls,
+            s.last_poll
+                .map(|t| format!("{:.3}s", now.duration_since(t).as_secs_f64()))
+                .unwrap_or_else(|| "never".into()),
+            s.sends,
+            s.last_send
+                .as_ref()
+                .map(|(t, _)| format!("{:.3}s", now.duration_since(*t).as_secs_f64()))
+                .unwrap_or_else(|| "never".into()),
+            s.last_send.as_ref().map(|(_, w)| w.as_str()).unwrap_or(""),
+            s.state,
+        );
+    }
+    out
+}
